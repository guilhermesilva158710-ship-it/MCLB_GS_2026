def obter_vetor_frase(frase, modelo):
    """
    Transforma uma frase em um único vetor
    utilizando Mean Pooling.
    """

    palavras = frase.split()

    vetores = []

    for palavra in palavras:

        try:
            vetor = modelo.wv[palavra]
            vetores.append(vetor)

        except KeyError:
            continue

    # Nenhum vetor encontrado
    if len(vetores) == 0:

        return np.zeros(
            modelo.vector_size
        )

    # Média dos vetores
    vetor_medio = np.mean(
        vetores,
        axis=0
    )

    return vetor_medio


