# ============================================================
# FUNÇÃO DE CLASSIFICAÇÃO + FALLBACK
# ============================================================

def classificar_mensagem(
    mensagem,
    modelo,
    modelo_embedding,
    limiar=0.50
):

    # Normalizar mensagem
    texto_normalizado = limpar_e_lemmatizar(
        mensagem
    )

    # Criar vetor
    vetor = obter_vetor_frase(
        texto_normalizado,
        modelo_embedding
    )

    # Probabilidades
    probabilidades = modelo.predict_proba(
        [vetor]
    )[0]

    # Maior probabilidade
    indice = np.argmax(
        probabilidades
    )

    # Intenção
    intencao = modelo.classes_[indice]

    # Confiança
    confianca = probabilidades[indice]

    # Fallback
    if confianca >= limiar:

        resultado = intencao

    else:

        resultado = "FALLBACK_HUMANO"

    return resultado, confianca


