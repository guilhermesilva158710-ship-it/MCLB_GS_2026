def limpar_e_lemmatizar(texto):
    """
    Normaliza uma mensagem:
    - minúsculas
    - remove números e pontuação
    - remove stop words
    - realiza lemmatization
    - remove tokens muito curtos
    """

    texto = str(texto)

    # 1. Minúsculas
    texto_limpo = texto.lower()

    # 2. Remover números e caracteres especiais
    texto_limpo = re.sub(
        r'[^a-záàâãéèêíïóôõöúçñ\s]',
        '',
        texto_limpo
    )

    # 3. Processar com spaCy
    doc = nlp(texto_limpo)

    tokens_filtrados = []

    for token in doc:

        # Ignorar espaços
        if token.is_space:
            continue

        # Ignorar stop words
        if token.text in stop_words_pt:
            continue

        # Ignorar tokens muito pequenos
        if len(token.text) <= 1:
            continue

        # Lematização
        lema = token.lemma_.lower().strip()

        if lema:
            tokens_filtrados.append(lema)

    return " ".join(tokens_filtrados)


